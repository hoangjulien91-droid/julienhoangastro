---
import { Fingerprint } from 'lucide-react';
import { PROFILE } from '@/lib/data/profile';
---

<section class='surface-card animate-in animate-in-delay-2 flex flex-col justify-between'>
  <div>
    <div class='mb-6 flex items-center gap-3'>
      <div class='flex h-11 w-11 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary'>
        <Fingerprint className='h-5 w-5' />
      </div>
      <h3 class='text-xl font-bold font-serif text-foreground'>Domaines d'Expertise</h3>
    </div>

    <div class='flex flex-wrap gap-2'>
      {PROFILE.skills.map((skill: string) => (
        <span class='border-border/80 bg-secondary/70 text-foreground hover:border-primary/50 hover:bg-primary/5 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors'>
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>

