---
import { GraduationCap, ShieldCheck } from 'lucide-react';
import { PROFILE, type Credential } from '@/lib/data/profile';
---

<section class='surface-card animate-in animate-in-delay-1 flex flex-col justify-between'>
  <div>
    <div class='mb-6 flex items-center gap-3'>
      <div class='flex h-11 w-11 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary'>
        <GraduationCap className='h-5 w-5' />
      </div>
      <h3 class='text-xl font-bold font-serif text-foreground'>Formation & Agréments</h3>
    </div>

    <ul class='space-y-4'>
      {PROFILE.credentials.map((credential: Credential) => (
        <li class='flex items-start gap-3 border-b border-border/40 pb-3 last:border-0 last:pb-0'>
          {credential.type === 'certification' ? (
            <div class='mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-amber-600/30 bg-amber-500/10 text-gold'>
              <ShieldCheck className='h-3.5 w-3.5' />
            </div>
          ) : (
            <div class='mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-primary/40'>
              <div class='h-1.5 w-1.5 rounded-full bg-primary' />
            </div>
          )}
          <div>
            <p class='text-sm font-semibold text-foreground'>{credential.title}</p>
            <p class='text-muted-foreground text-xs'>{credential.institution}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class='mt-6 pt-4 border-t border-border/40 flex items-center justify-between'>
      <span class='text-xs text-muted-foreground'>Psychologie du travail (Cnam)</span>
      <a
        href='/pst'
        class='inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline group'
      >
        <span>Carnet d'ateliers &amp; révision</span>
        <span class='transition-transform group-hover:translate-x-0.5'>&rarr;</span>
      </a>
    </div>
  </div>
</section>

