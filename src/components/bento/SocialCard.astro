---
import type { Social } from '@/lib/data/profile';

interface Props {
  socials: readonly Social[];
}

const { socials } = Astro.props;
---

<nav
  class="surface-card animate-in animate-in-delay-4 flex flex-col justify-between"
  aria-label="Réseaux professionnels"
>
  <div>
    <h2 class="text-foreground mb-4 font-serif text-xl font-bold">
      Réseaux &amp; Veille
    </h2>
    <p class="text-muted-foreground mb-6 text-sm leading-relaxed">
      Suivez mes publications juridiques, retours d&apos;expérience et analyses.
    </p>
  </div>

  <div class="flex flex-wrap gap-3">
    {socials.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        class="border-border/80 bg-secondary/80 text-foreground hover:border-primary/50 hover:bg-primary/10 hover:text-primary inline-flex items-center gap-2 rounded-xl border px-3.5 py-2.5 text-xs font-semibold transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={`${social.platform} (nouvel onglet)`}
      >
        {social.icon === 'linkedin' ? (
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
          </svg>
        ) : (
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        )}
        <span>{social.platform === 'Twitter' ? 'X / Twitter' : social.platform}</span>
      </a>
    ))}
  </div>
</nav>
