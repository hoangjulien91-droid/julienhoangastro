---
/**
 * S-TIER: JSON-LD Structured Data for Knowledge Graph
 *
 * Comprehensive Person and ProfilePage schema with worksFor, alumniOf, author relationships.
 * Designed to trigger Google Knowledge Graph and link authority to Ikerketa and Detective Conseil.
 */
import { PROFILE } from '@/lib/data/profile';

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${PROFILE.seo.url}/#person`,
      name: PROFILE.identity.name,
      url: PROFILE.seo.url,
      image: `${PROFILE.seo.url}/images/julien-hoang-detective-prive.webp`,
      jobTitle: PROFILE.identity.title,
      description: PROFILE.seo.description,
      email: `mailto:${PROFILE.identity.email}`,
      worksFor: [
        {
          '@type': 'Organization',
          name: 'Ikerketa Investigations',
          url: 'https://ikerketa.fr',
        },
        {
          '@type': 'Organization',
          name: 'Détective Conseil',
          url: 'https://detective-conseil.fr',
        },
      ],
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Université Panthéon-Assas (Paris II)',
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'Université Paris-Saclay',
        },
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'Autorisation d’exercice & Agrément de dirigeant d’agence de recherches privées',
          recognizedBy: {
            '@type': 'GovernmentOrganization',
            name: 'Conseil National des Activités Privées de Sécurité (CNAPS)',
          },
        },
      ],
      author: {
        '@type': 'Book',
        name: 'Une preuve peut tout changer',
        description: 'Ouvrage de méthode & stratégie probatoire',
      },
      knowsAbout: [
        'Stratégie de la preuve',
        'Enquêtes privées & Surveillances',
        'OSINT & Cyber-investigation',
        'Recherche d’actifs & Contentieux d’affaires',
        'Droit de la preuve & Procédure civile',
      ],
      homeLocation: {
        '@type': 'Place',
        name: 'Pays Basque, France',
      },
      sameAs: [
        'https://www.linkedin.com/in/julienhoang',
        'https://twitter.com/julienhoang',
        'https://ikerketa.fr',
        'https://detective-conseil.fr',
      ],
    },
    {
      '@type': 'ProfilePage',
      '@id': `${PROFILE.seo.url}/#webpage`,
      url: PROFILE.seo.url,
      name: `${PROFILE.identity.name} | Portfolio & Stratégie de la preuve`,
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${PROFILE.seo.url}/#website`,
        name: PROFILE.identity.name,
        url: PROFILE.seo.url,
      },
      about: {
        '@id': `${PROFILE.seo.url}/#person`,
      },
      mainEntity: {
        '@id': `${PROFILE.seo.url}/#person`,
      },
      primaryImageOfPage: `${PROFILE.seo.url}/images/julien-hoang-detective-prive.webp`,
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

