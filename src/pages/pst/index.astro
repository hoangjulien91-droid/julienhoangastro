---
import Layout from '@/layouts/Layout.astro';
import { PstApp } from '@/components/pst/apps/PstApp';
---

<Layout
  title="Centre de Pilotage — Ateliers PST Master Cnam | Julien Hoang"
  description="Cockpit unifié de révision, flashcards SM-2, 11 schémas vectoriels SVG et planning officiel en psychologie du travail au Cnam."
  noindex={true}
>
  <div class="min-h-screen py-4 sm:py-6 px-2 sm:px-6">
    <nav class="max-w-6xl mx-auto mb-3 px-1" aria-label="Fil d'Ariane">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 text-[11px] font-mono text-muted-foreground shadow-2xs">
        <a href="/" class="hover:text-foreground transition-colors">Accueil</a>
        <span class="opacity-40">/</span>
        <span class="text-foreground font-semibold">Formation &amp; Recherche</span>
        <span class="opacity-40">/</span>
        <span class="text-amber-600 dark:text-amber-400 font-bold">Cockpit PST</span>
      </div>
    </nav>

    <PstApp module="hub" client:load />
  </div>
</Layout>
