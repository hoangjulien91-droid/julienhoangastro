---
import { ViewTransitions } from 'astro:transitions';
import JsonLd from '@/components/seo/JsonLd.astro';
import '@/styles/globals.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Julien Hoang — Espace Professionnel", noindex = false } = Astro.props;

// RÈGLE STRICTE : Seule la page d'accueil ('/' ou '') est indexée. TOUTES les autres pages du site sont strictement en noindex.
const pathname = (Astro.url.pathname || '/').replace(/\/+$/, '') || '/';
const isHomepage = pathname === '/';
const isNoIndex = noindex || !isHomepage;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {isNoIndex ? (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
        <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <JsonLd />
      </>
    )}

    <ViewTransitions />

    <!-- Script de gestion du theme (Light par defaut, sauvegarde utilisateur ou preference systeme) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light'; // Light mode par defaut
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen font-sans">
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
