{
  "extends": "./node_modules/astro/tsconfigs/strict.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "next-view-transitions": ["src/components/common/Link.tsx"],
      "next/link": ["src/components/common/Link.tsx"],
      "next/navigation": ["src/components/common/Navigation.ts"]
    }
  },
  "include": [
    "src/**/*",
    "env.d.ts"
  ]
}
